// BeeCodeFi database schema — mirrors files/03-database-schema.md
// Phase 0 scope: identity & auth tables only. Content-meta, progress,
// GitHub, and gamification tables land in their respective phases so the
// schema grows with the product instead of being speculative up front.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext]
}

enum UserRole {
  learner
  author
  admin
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique @db.Citext
  passwordHash  String?   @map("password_hash")
  displayName   String    @map("display_name")
  avatarUrl     String?   @map("avatar_url")
  role          UserRole  @default(learner)
  emailVerified Boolean   @default(false) @map("email_verified")
  createdAt     DateTime  @default(now()) @map("created_at")
  deletedAt     DateTime? @map("deleted_at")

  authProviders UserAuthProvider[]
  settings      UserSettings?

  @@map("users")
}

model UserAuthProvider {
  id             String @id @default(uuid()) @db.Uuid
  userId         String @map("user_id") @db.Uuid
  provider       String
  providerUserId String @map("provider_user_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@map("user_auth_providers")
}

model UserSettings {
  userId           String @id @map("user_id") @db.Uuid
  theme            String @default("system")
  editorPrefs      Json   @default("{}") @map("editor_prefs")
  dailyGoalMinutes Int    @default(30) @map("daily_goal_minutes")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}
