{
  "name": "@beecodefi/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm --filter @beecodefi/schemas build && nest build",
    "start": "node dist/main.js",
    "start:dev": "pnpm --filter @beecodefi/schemas build && nest start --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "pnpm --filter @beecodefi/schemas build && tsc --noEmit",
    "test": "jest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@beecodefi/schemas": "workspace:*",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.0",
    "@prisma/client": "^5.19.0",
    "argon2": "^0.40.3",
    "cookie-parser": "^1.4.6",
    "jsonwebtoken": "^9.0.2",
    "parse5": "^7.1.2",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.0",
    "@types/passport-github2": "^1.2.9",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.5.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prisma": "^5.19.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0"
  }
}
